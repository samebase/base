{
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "oxc.fmt.configPath": "./vite.config.ts",
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },
  "npm.scriptRunner": "pnpm",
  // The user might have their own settins in user settings, but we need to enforce this
  "[javascript][javascriptreact][typescript][typescriptreact][json][jsonc][yaml][toml][html][css][scss][less][markdown][mdx][graphql]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },

  // Exclude the generated route tree file from being watched, searched, and edited directly
  "files.watcherExclude": {
    "**/routeTree.gen.ts": true
  },
  "search.exclude": {
    "**/routeTree.gen.ts": true
  },
  "files.readonlyInclude": {
    "**/routeTree.gen.ts": true
  }
}
