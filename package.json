{
  "name": "samebase-base",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.ts",
    "#hooks/*": "./src/hooks/*.ts"
  },
  "scripts": {
    "dev": "node ./scripts/run-context-dev.ts",
    "dev:primary": "node ./scripts/run-primary-dev.ts",
    "dev:frontend": "vp dev",
    "dev:worktree": "node ./scripts/run-worktree-dev.ts",
    "check": "vp check && vp run typecheck && vp test",
    "build": "vp run check && vp build",
    "deploy": "convex-hosting deploy --build \"vp run build && node ./scripts/ensure-convex-auth.ts --prod\" --dist dist/client --html-handling drop-trailing-slash",
    "deploy:dev": "convex-hosting deploy --dev --build \"vp run build && node ./scripts/ensure-convex-auth.ts\" --dist dist/client --html-handling drop-trailing-slash",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp lint --report-unused-disable-directives",
    "preview": "vp preview",
    "prepare": "vp config --no-agent",
    "test": "vp test",
    "typecheck": "tsc && vp run typecheck:node && tsc --project convex/tsconfig.json",
    "typecheck:node": "tsc --project tsconfig.node.json"
  },
  "dependencies": {
    "@convex-dev/auth": "2.0.0-beta.0",
    "@convex-dev/react-query": "^0.1.0",
    "@fontsource/google-sans": "^5.3.2",
    "@samebase/convex-auth-tanstack-start": "^0.1.1",
    "@samebase/convex-hosting": "^0.14.0",
    "@samebase/convex-hosting-tanstack-start": "^0.11.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "^1.169.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.48.0",
    "lucide-react": "^1.64.0",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@alchemy.run/github": "2.0.0-beta.84",
    "@effect/platform-node": "4.0.5",
    "@samebase/alchemy-convex": "0.20.0",
    "@tanstack/router-plugin": "^1.168.48",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "alchemy": "2.0.0-beta.84",
    "effect": "4.0.5",
    "shadcn": "4.22.1",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@12.15.0"
}
